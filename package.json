{
  "name": "forktrace",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "demo": "node --import tsx src/demo.ts",
    "demo:reset": "node --import tsx src/demo-reset.ts",
    "demo:audit": "node --import tsx test/demo-determinism.ts",
    "fork": "node --import tsx src/fork-cli.ts",
    "replay": "node --import tsx src/replay-cli.ts",
    "diff": "node --import tsx src/diff-cli.ts",
    "dev": "vite",
    "preview": "vite preview",
    "e2e": "node --import tsx test/e2e.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test test/**/*.test.ts",
    "build": "tsc -p tsconfig.build.json && vite build"
  },
  "dependencies": {
    "@openai/agents": "^0.3.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "eslint": "^9.0.0",
    "prettier": "^3.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.0.0",
    "typescript-eslint": "^8.0.0",
    "vite": "^8.1.5"
  }
}
